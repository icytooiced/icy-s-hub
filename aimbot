	label.Position = UDim2.new(0, 15, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(220, 220, 230)
	label.TextXAlignment = Enum.TextXAlignment.Left

	local dropdown = Instance.new("TextButton", frame)
	dropdown.Size = UDim2.new(0.45, 0, 0, 32)
	dropdown.Position = UDim2.new(0.53, 0, 0.5, 0)
	dropdown.AnchorPoint = Vector2.new(0, 0.5)
	dropdown.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	dropdown.Text = defaultValue
	dropdown.Font = Enum.Font.GothamBold
	dropdown.TextSize = 14
	dropdown.TextColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", dropdown).CornerRadius = UDim.new(0, 8)

	local dropdownOpen = false
	local dropdownFrame = Instance.new("Frame", frame)
	dropdownFrame.Size = UDim2.new(0.45, 0, 0, #options * 35)
	dropdownFrame.Position = UDim2.new(0.53, 0, 1, 5)
	dropdownFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
	dropdownFrame.Visible = false
	dropdownFrame.ZIndex = 10
	Instance.new("UICorner", dropdownFrame).CornerRadius = UDim.new(0, 8)

	local dropStroke = Instance.new("UIStroke", dropdownFrame)
	dropStroke.Color = Color3.fromRGB(0, 170, 255)

	local dropLayout = Instance.new("UIListLayout", dropdownFrame)
	dropLayout.Padding = UDim.new(0, 2)

	for _, option in ipairs(options) do
		local optionButton = Instance.new("TextButton", dropdownFrame)
		optionButton.Size = UDim2.new(1, 0, 0, 33)
		optionButton.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
		optionButton.Text = option
		optionButton.Font = Enum.Font.Gotham
		optionButton.TextSize = 13
		optionButton.TextColor3 = Color3.new(1, 1, 1)
		optionButton.ZIndex = 11

		optionButton.MouseButton1Click:Connect(function()
			dropdown.Text = option
			callback(option)
			dropdownFrame.Visible = false
			dropdownOpen = false
		end)
	end

	dropdown.MouseButton1Click:Connect(function()
		dropdownOpen = not dropdownOpen
		dropdownFrame.Visible = dropdownOpen
	end)

	return dropdown
end

