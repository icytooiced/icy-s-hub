--// ESP FUNCTIONS
local function GetTeamColor(player)
	if player.Team then
		return player.Team.TeamColor.Color
	end
	return Color3.fromRGB(255, 255, 255)
end

local function CreateESP(player)
	if player == LocalPlayer then return end

	local drawings = {
		box = Drawing.new("Square"),
		boxOutline = Drawing.new("Square"),
		tracer = Drawing.new("Line"),
		name = Drawing.new("Text"),
		distance = Drawing.new("Text"),
		health = Drawing.new("Text"),
		healthBar = Drawing.new("Line"),
		healthBarOutline = Drawing.new("Line")
	}

	-- Box setup
	drawings.box.Thickness = 2
	drawings.box.Filled = false
	drawings.box.Color = Color3.fromRGB(0, 170, 255)
	drawings.box.Visible = false
	drawings.box.ZIndex = 2

	drawings.boxOutline.Thickness = 4
	drawings.boxOutline.Filled = false
	drawings.boxOutline.Color = Color3.fromRGB(0, 0, 0)
	drawings.boxOutline.Visible = false
	drawings.boxOutline.ZIndex = 1

	-- Tracer setup
	drawings.tracer.Thickness = 2
	drawings.tracer.Color = Color3.fromRGB(0, 170, 255)
	drawings.tracer.Visible = false

	-- Name setup
	drawings.name.Size = 14
	drawings.name.Center = true
	drawings.name.Outline = true
	drawings.name.OutlineColor = Color3.fromRGB(0, 0, 0)
	drawings.name.Color = Color3.fromRGB(255, 255, 255)
	drawings.name.Visible = false

	-- Distance setup
	drawings.distance.Size = 12
	drawings.distance.Center = true
	drawings.distance.Outline = true
	drawings.distance.OutlineColor = Color3.fromRGB(0, 0, 0)
	drawings.distance.Color = Color3.fromRGB(200, 200, 200)
	drawings.distance.Visible = false

	-- Health setup
	drawings.health.Size = 12
	drawings.health.Center = true
	drawings.health.Outline = true
	drawings.health.OutlineColor = Color3.fromRGB(0, 0, 0)
	drawings.health.Color = Color3.fromRGB(0, 255, 0)
	drawings.health.Visible = false

	-- Health bar setup
	drawings.healthBar.Thickness = 3
	drawings.healthBar.Color = Color3.fromRGB(0, 255, 0)
	drawings.healthBar.Visible = false

	drawings.healthBarOutline.Thickness = 5
	drawings.healthBarOutline.Color = Color3.fromRGB(0, 0, 0)
	drawings.healthBarOutline.Visible = false

	ESPObjects[player] = {
		drawings = drawings
	}
end

local function RemoveESP(player)
	local espData = ESPObjects[player]
	if espData then
		for _, drawing in pairs(espData.drawings) do
			if drawing then
				drawing:Remove()
			end
		end
		ESPObjects[player] = nil
	end
end

local function UpdateESP()
	for player, espData in pairs(ESPObjects) do
		if not player or not player.Parent or not player.Character then
			RemoveESP(player)
			continue
		end

		local character = player.Character
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local rootPart = character:FindFirstChild("HumanoidRootPart")

		if not rootPart or not humanoid or humanoid.Health <= 0 then
			for _, drawing in pairs(espData.drawings) do
				drawing.Visible = false
			end
			continue
		end

		-- Team check
		if TeamCheck and player.Team == LocalPlayer.Team then
			for _, drawing in pairs(espData.drawings) do
				drawing.Visible = false
			end
			continue
		end

		local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
		
		if onScreen and ESPEnabled then
			local hrp2D = Camera:WorldToViewportPoint(rootPart.Position)
			local head3D = character:FindFirstChild("Head")
			local head2D = head3D and Camera:WorldToViewportPoint(head3D.Position + Vector3.new(0, 1, 0)) or hrp2D
			
			local legPosition = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
			
			local height = math.abs(head2D.Y - legPosition.Y)
			local width = height / 2

			local teamColor = GetTeamColor(player)

			-- Update box
			if ShowBoxes then
				espData.drawings.box.Size = Vector2.new(width, height)
				espData.drawings.box.Position = Vector2.new(hrp2D.X - width / 2, head2D.Y)
				espData.drawings.box.Color = teamColor
				espData.drawings.box.Visible = true

				espData.drawings.boxOutline.Size = Vector2.new(width, height)
				espData.drawings.boxOutline.Position = Vector2.new(hrp2D.X - width / 2, head2D.Y)
				espData.drawings.boxOutline.Visible = true
			else
				espData.drawings.box.Visible = false
				espData.drawings.boxOutline.Visible = false
			end

			-- Update tracer
			if ShowTracers then
				espData.drawings.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
				espData.drawings.tracer.To = Vector2.new(hrp2D.X, legPosition.Y)
				espData.drawings.tracer.Color = teamColor
				espData.drawings.tracer.Visible = true
			else
				espData.drawings.tracer.Visible = false
			end

			-- Update name
			if ShowNames then
				espData.drawings.name.Text = player.Name
				espData.drawings.name.Position = Vector2.new(hrp2D.X, head2D.Y - 20)
				espData.drawings.name.Visible = true
			else
				espData.drawings.name.Visible = false
			end

			-- Update distance
			if ShowDistance then
				local distance = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude)
				espData.drawings.distance.Text = distance .. " studs"
				espData.drawings.distance.Position = Vector2.new(hrp2D.X, legPosition.Y + 5)
				espData.drawings.distance.Visible = true
			else
				espData.drawings.distance.Visible = false
			end

			-- Update health
			if ShowHealth then
				local healthPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
				espData.drawings.health.Text = healthPercent .. "%"
				espData.drawings.health.Position = Vector2.new(hrp2D.X, legPosition.Y + 20)
				
				if healthPercent > 75 then
					espData.drawings.health.Color = Color3.fromRGB(0, 255, 0)
				elseif healthPercent > 50 then
					espData.drawings.health.Color = Color3.fromRGB(255, 255, 0)
				elseif healthPercent > 25 then
					espData.drawings.health.Color = Color3.fromRGB(255, 165, 0)
				else
					espData.drawings.health.Color = Color3.fromRGB(255, 0, 0)
				end
				
				espData.drawings.health.Visible = true

				-- Health bar
				local barHeight = height * (humanoid.Health / humanoid.MaxHealth)
				espData.drawings.healthBar.From = Vector2.new(hrp2D.X - width / 2 - 6, head2D.Y)
				espData.drawings.healthBar.To = Vector2.new(hrp2D.X - width / 2 - 6, head2D.Y + height - barHeight)
				espData.drawings.healthBar.Color = espData.drawings.health.Color
				espData.drawings.healthBar.Visible = true

				espData.drawings.healthBarOutline.From = Vector2.new(hrp2D.X - width / 2 - 6, head2D.Y)
				espData.drawings.healthBarOutline.To = Vector2.new(hrp2D.X - width / 2 - 6, head2D.Y + height)
				espData.drawings.healthBarOutline.Visible = true
			else
				espData.drawings.health.Visible = false
				espData.drawings.healthBar.Visible = false
				espData.drawings.healthBarOutline.Visible = false
			end
		else
			for _, drawing in pairs(espData.drawings) do
				drawing.Visible = false
			end
		end
	end
end

--// PLAYER CONNECTIONS
for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		CreateESP(player)
	end
end

Players.PlayerAdded:Connect(function(player)
	CreateESP(player)
end)

Players.PlayerRemoving:Connect(function(player)
	RemoveESP(player)
end)

--// RENDER LOOP
RunService.RenderStepped:Connect(function()
	UpdateESP()
end)

--// CLEANUP ON DESTROY
ScreenGui.Destroying:Connect(function()
	for player, _ in pairs(ESPObjects) do
		RemoveESP(player)
	end
end)
