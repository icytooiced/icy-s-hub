local Buttons = {}
for i = 1,10 do
	local b = Instance.new("TextButton", ButtonHolder)
	b.Size = UDim2.fromOffset(120,35)
	b.Position = UDim2.new(0.05 + ((i-1)%3)*0.32, 0, 0.05 + math.floor((i-1)/3)*0.18, 0)
	b.Text = tostring(i)
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 18
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)
	Instance.new("UICorner", b)
	Buttons[i] = b
end

Buttons[1].Text = "ESP"
Buttons[2].Text = "Aimbot"
Buttons[3].Text = "Admin"

-- Minimize
local minimized = false
Min.MouseButton1Click:Connect(function()
	minimized = not minimized
	ButtonHolder.Visible = not minimized
	MainFrame.Size = minimized and UDim2.fromOffset(420,40) or UDim2.fromOffset(420,300)
end)

Close.MouseButton1Click:Connect(function()
	MainGui:Destroy()
end)

