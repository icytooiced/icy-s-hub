--// BUTTONS
--// =========================
local Buttons = {}
local ToggleState = {}

for i = 1,10 do
	local b = Instance.new("TextButton", ButtonHolder)
	b.Size = UDim2.fromOffset(120,35)
	b.Position = UDim2.new(0.05 + ((i-1)%3)*0.32, 0, 0.05 + math.floor((i-1)/3)*0.18, 0)
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)
	b.TextColor3 = Color3.new(1,1,1)
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 16
	Instance.new("UICorner", b)
	Buttons[i] = b
	ToggleState[i] = false
end

Buttons[1].Text = "ESP [OFF]"
Buttons[2].Text = "Aimbot [OFF]"
Buttons[3].Text = "Admin"
Buttons[4].Text = "Fly [OFF]"
Buttons[5].Text = "Noclip [OFF]"

local function ToggleButton(i, name, callback)
	Buttons[i].MouseButton1Click:Connect(function()
		ToggleState[i] = not ToggleState[i]

		if ToggleState[i] then
			Buttons[i].Text = name .. " [ON]"
			Buttons[i].BackgroundColor3 = Color3.fromRGB(60,160,90)
			if callback then callback() end
		else
			Buttons[i].Text = name .. " [OFF]"
			Buttons[i].BackgroundColor3 = Color3.fromRGB(40,40,40)
		end
	end)
end

