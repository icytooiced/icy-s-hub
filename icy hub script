--// =========================
--// KEY CHECK
--// =========================
KeyBox.FocusLost:Connect(function(enter)
	if not enter then return end
	if ValidKeys[KeyBox.Text:lower()] then
		KeyGui:Destroy()
		MainGui.Enabled = true
	else
		Status.Text = "Invalid Key"
		Status.TextColor3 = Color3.new(1,0,0)
	end
end)
