--// TWEEN HELPER
local function Tween(object, properties, duration, style, direction)
    style = style or Enum.EasingStyle.Quad
    direction = direction or Enum.EasingDirection.Out
    local tweenInfo = TweenInfo.new(duration, style, direction)
    return TweenService:Create(object, tweenInfo, properties)
end

--// PARTICLE EFFECTS
local function AddParticles(gui)
    local emitter = Instance.new("Frame")
    emitter.Size = UDim2.fromScale(1,1)
    emitter.BackgroundTransparency = 1
    emitter.Parent = gui
    local numParticles = 25
    for i=1,numParticles do
        local p = Instance.new("Frame", emitter)
        p.Size = UDim2.fromOffset(6,6)
        p.Position = UDim2.new(math.random(),0,math.random(),0)
        p.BackgroundColor3 = Color3.fromRGB(0,170,255)
        p.BorderSizePixel = 0
        p.BackgroundTransparency = 0.6
        local uic = Instance.new("UICorner", p)
        uic.CornerRadius = UDim.new(1,0)
        -- Animate movement
        coroutine.wrap(function()
            while p.Parent do
                local dx = math.random(-30,30)/100
                local dy = math.random(-30,30)/100
                Tween(p, {Position = p.Position + UDim2.new(dx,0,dy,0)}, math.random(2,5)):Play()
                wait(math.random(2,5))
            end
        end)()
    end
end

--// PROGRESS BAR
local function ShowProgressBar(duration, text, callback)
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "ProgressGui"
    Gui.ResetOnSpawn = false
    Gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local Frame = Instance.new("Frame", Gui)
    Frame.Size = UDim2.fromOffset(300,60)
    Frame.Position = UDim2.fromScale(0.5,0.5) - UDim2.fromOffset(150,30)
    Frame.BackgroundColor3 = Color3.fromRGB(35,35,35)
    Frame.BorderSizePixel = 0
    Frame.BackgroundTransparency = 1
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0,12)
    Tween(Frame, {BackgroundTransparency = 0}, 0.5):Play()

    local Label = Instance.new("TextLabel", Frame)
    Label.Size = UDim2.new(1,0,0.4,0)
    Label.Position = UDim2.fromScale(0,0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 18
    Label.TextColor3 = Color3.fromRGB(255,255,255)

    local ProgressBg = Instance.new("Frame", Frame)
    ProgressBg.Size = UDim2.fromScale(0.9,0.3)
    ProgressBg.Position = UDim2.fromScale(0.05,0.6)
    ProgressBg.BackgroundColor3 = Color3.fromRGB(50,50,50)
    Instance.new("UICorner", ProgressBg).CornerRadius = UDim.new(0,6)

    local Progress = Instance.new("Frame", ProgressBg)
    Progress.Size = UDim2.fromScale(0,1)
    Progress.BackgroundColor3 = Color3.fromRGB(0,170,255)
    Instance.new("UICorner", Progress).CornerRadius = UDim.new(0,6)

    local startTime = tick()
    local conn
    conn = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed/duration,0,1)
        Progress.Size = UDim2.fromScale(progress,1)
        if progress >= 1 then
            conn:Disconnect()
            Tween(Frame, {BackgroundTransparency=1}, 0.5):Play()
            wait(0.5)
            Gui:Destroy()
            if callback then callback() end
        end
    end)
end

