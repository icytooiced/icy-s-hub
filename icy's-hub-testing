--// TWEEN HELPER
local function Tween(obj, props, t)
	return TweenService:Create(
		obj,
		TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props
	)
end

--// PROGRESS BAR (TOP CENTER)
local function ShowProgress(duration, text, callback)
	local gui = Instance.new("ScreenGui")
	gui.Name = "ProgressGui"
	gui.ResetOnSpawn = false
	gui.Parent = PlayerGui

	local frame = Instance.new("Frame", gui)
	frame.Size = UDim2.fromOffset(320, 65)
	frame.Position = UDim2.fromScale(0.5, 0) + UDim2.fromOffset(-160, 20)
	frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
	frame.BorderSizePixel = 0
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0,12)

	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(1,0,0.5,0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextColor3 = Color3.new(1,1,1)

	local bg = Instance.new("Frame", frame)
	bg.Position = UDim2.fromScale(0.05,0.6)
	bg.Size = UDim2.fromScale(0.9,0.25)
	bg.BackgroundColor3 = Color3.fromRGB(50,50,50)
	Instance.new("UICorner", bg)

	local bar = Instance.new("Frame", bg)
	bar.Size = UDim2.fromScale(0,1)
	bar.BackgroundColor3 = Color3.fromRGB(0,170,255)
	Instance.new("UICorner", bar)

	local start = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local p = math.clamp((tick()-start)/duration,0,1)
		bar.Size = UDim2.fromScale(p,1)
		if p >= 1 then
			conn:Disconnect()
			gui:Destroy()
			if callback then callback() end
		end
	end)
end

--// PARTICLES (CLIPPED)
local function AddParticles(frame)
	frame.ClipsDescendants = true
	for i = 1,16 do
		local p = Instance.new("Frame", frame)
		p.Size = UDim2.fromOffset(6,6)
		p.Position = UDim2.new(math.random(),0,math.random(),0)
		p.BackgroundColor3 = Color3.fromRGB(0,170,255)
		p.BackgroundTransparency = 0.6
		p.BorderSizePixel = 0
		Instance.new("UICorner", p).CornerRadius = UDim.new(1,0)

		task.spawn(function()
			while p.Parent do
				Tween(p,{
					Position = UDim2.new(
						math.clamp(p.Position.X.Scale + math.random(-3,3)/100,0,1),
						0,
						math.clamp(p.Position.Y.Scale + math.random(-3,3)/100,0,1),
						0
					)
				}, math.random(3,6)):Play()
				task.wait(math.random(3,6))
			end
		end)
	end
end

