--// SAVE / LOAD KEY
local function SaveKey(key)
	if writefile then
		writefile(SAVE_KEY_FILE, key)
	end
end

local function LoadKey()
	if readfile and isfile and isfile(SAVE_KEY_FILE) then
		return readfile(SAVE_KEY_FILE)
	end
end

--// TWEEN HELPER
local function Tween(obj, props, time, style, dir)
	return TweenService:Create(
		obj,
		TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
end

--// TEXT GLOW ANIMATION
local function AnimateText(label)
	task.spawn(function()
		while label.Parent do
			Tween(label,{TextColor3 = Color3.fromRGB(0,170,255)},1):Play()
			task.wait(1)
			Tween(label,{TextColor3 = Color3.fromRGB(180,220,255)},1):Play()
			task.wait(1)
		end
	end)
end

