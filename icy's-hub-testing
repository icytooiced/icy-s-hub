--// TWEEN HELPER
local function Tween(obj, props, time)
	return TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
end

--// PARTICLES (CLIPPED)
local function AddParticles(frame)
	frame.ClipsDescendants = true
	for i = 1, 18 do
		local p = Instance.new("Frame", frame)
		p.Size = UDim2.fromOffset(6,6)
		p.Position = UDim2.new(math.random(),0,math.random(),0)
		p.BackgroundColor3 = Color3.fromRGB(0,170,255)
		p.BackgroundTransparency = 0.6
		p.BorderSizePixel = 0
		Instance.new("UICorner", p).CornerRadius = UDim.new(1,0)

		task.spawn(function()
			while p.Parent do
				Tween(p,{
					Position = UDim2.new(
						math.clamp(p.Position.X.Scale + math.random(-3,3)/100,0,1),
						0,
						math.clamp(p.Position.Y.Scale + math.random(-3,3)/100,0,1),
						0)
				}, math.random(3,6)):Play()
				task.wait(math.random(3,6))
			end
		end)
	end
end

--// PROGRESS BAR
local function ShowProgress(duration, text, cb)
	local g = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
	local f = Instance.new("Frame", g)
	f.Size = UDim2.fromOffset(300,70)
	f.Position = UDim2.fromScale(.5,.5) - UDim2.fromOffset(150,35)
	f.BackgroundColor3 = Color3.fromRGB(30,30,30)
	f.BorderSizePixel = 0
	Instance.new("UICorner", f)

	local t = Instance.new("TextLabel", f)
	t.Size = UDim2.new(1,0,.5,0)
	t.BackgroundTransparency = 1
	t.Text = text
	t.Font = Enum.Font.GothamBold
	t.TextSize = 18
	t.TextColor3 = Color3.new(1,1,1)

	local bg = Instance.new("Frame", f)
	bg.Position = UDim2.fromScale(.05,.65)
	bg.Size = UDim2.fromScale(.9,.2)
	bg.BackgroundColor3 = Color3.fromRGB(50,50,50)
	Instance.new("UICorner", bg)

	local bar = Instance.new("Frame", bg)
	bar.Size = UDim2.fromScale(0,1)
	bar.BackgroundColor3 = Color3.fromRGB(0,170,255)
	Instance.new("UICorner", bar)

	local start = tick()
	local c; c = RunService.RenderStepped:Connect(function()
		local p = math.clamp((tick()-start)/duration,0,1)
		bar.Size = UDim2.fromScale(p,1)
		if p >= 1 then
			c:Disconnect()
			g:Destroy()
			if cb then cb() end
		end
	end)
end

