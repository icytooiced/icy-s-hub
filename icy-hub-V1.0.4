--snowflake
local function spawnSnowflake()
	local flake = Instance.new("ImageLabel")
	flake.BackgroundTransparency = 1
	flake.Size = UDim2.new(0, math.random(6,14), 0, math.random(6,14))
	flake.Position = UDim2.new(math.random(), 0, 0, -20) -- start slightly above screen
	flake.Image = "rbxassetid://12103422072"
	flake.ImageTransparency = 0.25 + math.random()*0.3
	flake.ZIndex = 5
	flake.Parent = snowFrame

	local fallTime = math.random(4,7) -- seconds to fall
	local drift = math.random(-10,10)/100

	-- Tween to fall
	local goal = {Position = UDim2.new(flake.Position.X.Scale + drift, 0, 1.2, 0)}
	local tween = TweenService:Create(flake, TweenInfo.new(fallTime, Enum.EasingStyle.Linear), goal)
	tween:Play()

	-- Destroy after falling
	Debris:AddItem(flake, fallTime)
end

-- Spawn snowflakes gradually using Heartbeat
RunService.Heartbeat:Connect(function()
	if snowRunning then
		if math.random() < 0.35 then -- density control
			spawnSnowflake()
		end
	end
end)

