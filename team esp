----------------------------------------------------------------
-- ESP CREATION
----------------------------------------------------------------

local function createESP(player)
	if player == LocalPlayer then return end

	local function setup(char)
		local head = char:WaitForChild("Head",5)
		local humanoid = char:WaitForChild("Humanoid",5)
		if not head or not humanoid then return end

		local hl = Instance.new("Highlight")
		hl.FillTransparency = 0.6
		hl.Parent = char

		local bill = Instance.new("BillboardGui")
		bill.Size = UDim2.new(0,120,0,40)
		bill.StudsOffset = Vector3.new(0,2.5,0)
		bill.AlwaysOnTop = true
		bill.Parent = head

		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(1,0,0.6,0)
		name.BackgroundTransparency = 1
		name.Text = player.Name
		name.TextColor3 = Color3.new(1,1,1)
		name.Font = Enum.Font.GothamBold
		name.TextScaled = true
		name.Parent = bill

		local barBG = Instance.new("Frame")
		barBG.Size = UDim2.new(1,0,0.3,0)
		barBG.Position = UDim2.new(0,0,0.7,0)
		barBG.BackgroundColor3 = Color3.fromRGB(40,40,40)
		barBG.Parent = bill

		local bar = Instance.new("Frame")
		bar.BackgroundColor3 = Color3.fromRGB(0,255,0)
		bar.Size = UDim2.new(1,0,1,0)
		bar.Parent = barBG

		humanoid.HealthChanged:Connect(function()
			bar.Size = UDim2.new(humanoid.Health/humanoid.MaxHealth,0,1,0)
		end)

		ESPObjects[player] = {Highlight=hl,Billboard=bill}
	end

	if player.Character then
		setup(player.Character)
	end

	player.CharacterAdded:Connect(setup)
end

----------------------------------------------------------------
-- TEAM BUTTONS (FIXED)
----------------------------------------------------------------

local function rebuildTeamButtons()
	for _,child in ipairs(List:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _,team in ipairs(Teams:GetTeams()) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1,-5,0,30)
		btn.Text = team.Name
		btn.TextColor3 = Color3.new(1,1,1)
		btn.BackgroundColor3 = team.TeamColor.Color
		btn.Parent = List
		Instance.new("UICorner", btn)

		btn.MouseButton1Click:Connect(function()
			ActiveTeams[team] = not ActiveTeams[team]
			btn.BackgroundTransparency =
				ActiveTeams[team] and 0 or 0.5
		end)
	end
end

Teams.ChildAdded:Connect(rebuildTeamButtons)
Teams.ChildRemoved:Connect(rebuildTeamButtons)

task.wait(1)
rebuildTeamButtons()

----------------------------------------------------------------
-- DISTANCE UPDATE
----------------------------------------------------------------

RunService.RenderStepped:Connect(function()
	local myChar = LocalPlayer.Character
	if not myChar then return end
	local root = myChar:FindFirstChild("HumanoidRootPart")
	if not root then return end

	for player,data in pairs(ESPObjects) do
		local char = player.Character
		local enabled = player.Team and ActiveTeams[player.Team]

		if char and data then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and enabled then
				local dist = (root.Position-hrp.Position).Magnitude
				local fade = math.clamp(dist/MAX_DISTANCE,0,1)

				data.Highlight.Enabled = true
				data.Highlight.FillTransparency = 0.6 + fade*0.4
				data.Billboard.Enabled = true
			else
				data.Highlight.Enabled = false
				data.Billboard.Enabled = false
			end
		end
	end
end)

